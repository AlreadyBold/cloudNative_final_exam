# alyak-user-api-1, -2 컨테이너용. DB_PASSWORD 는 mysql.env 의 USER_DB_PASSWORD 와 같은 값.
DB_PASSWORD=
# 관리자 계정 (user-api 가 처음 뜰 때 없으면 만든다)
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=
# 처방내역 불러오기 하루 최대 횟수 (선택, 계정당, 기본 5)
# PRESCRIPTION_IMPORT_MAX_PER_DAY=5
# CODEF 키 (선택). 비워 두면 처방내역 불러오기가 모의(MOCK) 모드로 동작한다.
CODEF_SERVICE_TYPE=DEMO
CODEF_CLIENT_ID=
CODEF_CLIENT_SECRET=
CODEF_PUBLIC_KEY=
