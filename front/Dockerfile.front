# =====================================================================
# alyak-front 이미지 : 프론트 (순수 HTML / CSS / JavaScript, 빌드 도구 없음)
#
# 빌드 : (저장소 최상위에서) docker build -f front/Dockerfile.front -t junheong/alyak-front:1.0 front
# =====================================================================

# 프록시와 같은 nginx 이미지를 써서 레이어를 공유한다 (디스크 절약)
FROM nginx:1.31.8

ENV TZ=Asia/Seoul

# 기본 설정을 이 프로젝트 설정으로 교체
RUN rm /etc/nginx/conf.d/default.conf
COPY nginx.conf /etc/nginx/conf.d/alyak-front.conf

# 프론트 파일을 이미지 안에 복사 (바인드 마운트가 아니라 COPY 이므로 pull 만 해도 화면이 뜬다)
#  기본 index.html(Welcome to nginx)은 지우고 덮어쓴다
RUN rm -rf /usr/share/nginx/html/*
COPY html/ /usr/share/nginx/html/

EXPOSE 80
